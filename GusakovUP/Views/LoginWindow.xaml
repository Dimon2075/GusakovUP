<Window x:Class="GusakovUP.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vms="clr-namespace:GusakovUP.ViewModels"
        mc:Ignorable="d"
        Title="Авторизация" Height="480" Width="380"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">



    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,10,0,20">
            <TextBlock Text="PROJECT TASKER" FontFamily="{DynamicResource MainFont}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryHeaderBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="Вход в систему управления" FontFamily="{DynamicResource MainFont}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="Логин" FontFamily="{DynamicResource MainFont}" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Height="35" Margin="0,0,0,15" Padding="5,0" VerticalContentAlignment="Center" Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>

            <TextBlock Text="Пароль" FontFamily="{DynamicResource MainFont}" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,5"/>
            <PasswordBox x:Name="TxtPassword" Height="35" Padding="5,0" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,10,0,0" Visibility="{Binding IsCaptchaVisible, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <TextBlock Text="Введите код безопасности:" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,5"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding CaptchaInput, UpdateSourceTrigger=PropertyChanged}" Height="40" FontSize="16" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                <Button Grid.Column="1" Command="{Binding RefreshCaptchaCommand}" Margin="10,0,0,0" Background="Transparent" BorderThickness="0">
                    <Image Source="{Binding CaptchaImage}" Width="120" Height="40"/>
                </Button>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,15,0,0">
            <!-- Кнопка Входа -->
            <Button Content="Войти в систему" Height="40" Margin="0,20,0,0" 
        Background="{DynamicResource AccentButtonBrush}" Foreground="White" FontWeight="Bold" 
        Command="{Binding LoginCommand}" 
        CommandParameter="{Binding ElementName=TxtPassword}"/>


            <!-- Кнопка перехода на Регистрацию (Пункт 3 ТЗ) -->
            <Button Content="Ещё нет аккаунта? Зарегистрироваться" 
            Margin="0,10,0,0" Background="Transparent" BorderThickness="0" 
            Foreground="{DynamicResource PrimaryHeaderBrush}" Cursor="Hand"
            Click="RegisterLink_Click"/>
        </StackPanel>
    </Grid>
</Window>
