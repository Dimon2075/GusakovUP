<Window x:Class="GusakovUP.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GusakovUP.Views"
        mc:Ignorable="d"
        Title="Безопасность: Смена пароля" Height="360" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="ИЗМЕНЕНИЕ ПАРОЛЯ" 
                   FontFamily="{DynamicResource MainFont}" 
                   FontSize="16" FontWeight="Bold" 
                   Foreground="{DynamicResource PrimaryHeaderBrush}" 
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <!-- Старый пароль -->
            <TextBlock Text="Текущий пароль" FontFamily="{DynamicResource MainFont}" Margin="0,0,0,3" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <PasswordBox x:Name="OldPasswordBox" Height="35" Margin="0,0,0,12" VerticalContentAlignment="Center" Padding="5,0"
                         ToolTip="Введите ваш текущий пароль для подтверждения личности"/>

            <!-- Новый пароль -->
            <TextBlock Text="Новый пароль (минимум 4 символа)" FontFamily="{DynamicResource MainFont}" Margin="0,0,0,3" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <PasswordBox x:Name="NewPasswordBox" Height="35" Margin="0,0,0,12" VerticalContentAlignment="Center" Padding="5,0"
                         ToolTip="Придумайте новый безопасный пароль"/>

            <!-- Подтверждение -->
            <TextBlock Text="Подтвердите новый пароль" FontFamily="{DynamicResource MainFont}" Margin="0,0,0,3" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Height="35" VerticalContentAlignment="Center" Padding="5,0"
                         ToolTip="Повторите новый пароль еще раз без ошибок"/>
        </StackPanel>

        <!-- Кнопка сохранения -->
        <Button Grid.Row="2" Content="Сохранить изменения" Height="40" 
                Background="{DynamicResource AccentButtonBrush}" Foreground="White" FontWeight="Bold"
                Click="SaveButton_Click" Cursor="Hand"
                ToolTip="Записать новый хэш пароля в базу данных"/>
    </Grid>
</Window>
