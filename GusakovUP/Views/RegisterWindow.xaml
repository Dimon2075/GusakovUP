<Window x:Class="GusakovUP.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GusakovUP.Views"
        mc:Ignorable="d"
         Title="Регистрация в системе" Height="500" Width="380"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,5,0,15">
            <TextBlock Text="РЕГИСТРАЦИЯ" FontFamily="{DynamicResource MainFont}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryHeaderBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="Создание учетной записи сотрудника" FontFamily="{DynamicResource MainFont}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <!-- ФИО -->
            <TextBlock Text="Полное имя (ФИО)" FontFamily="{DynamicResource MainFont}" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,3"/>
            <TextBox x:Name="TxtFullName" Height="35" Margin="0,0,0,12" Padding="5,0" VerticalContentAlignment="Center" Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>

            <!-- Логин -->
            <TextBlock Text="Логин (Имя пользователя)" FontFamily="{DynamicResource MainFont}" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,3"/>
            <TextBox x:Name="TxtUsername" Height="35" Margin="0,0,0,12" Padding="5,0" VerticalContentAlignment="Center" Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>

            <!-- Пароль -->
            <TextBlock Text="Пароль" FontFamily="{DynamicResource MainFont}" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,3"/>
            <PasswordBox x:Name="TxtPassword" Height="35" Margin="0,0,0,12" Padding="5,0" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="2">
            <!-- Кнопка Создать аккаунт -->
            <Button Content="Зарегистрироваться" Height="40" Background="{DynamicResource AccentButtonBrush}" Foreground="White" FontWeight="Bold" Click="RegisterButton_Click"/>

            <!-- Вернуться назад -->
            <Button Content="Назад к авторизации" Margin="0,10,0,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource SecondaryTextBrush}" Cursor="Hand" Click="BackLink_Click"/>
        </StackPanel>
    </Grid>
</Window>