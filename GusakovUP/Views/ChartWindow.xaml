<Window x:Class="GusakovUP.Views.ChartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        mc:Ignorable="d"
        Title="Аналитика выполнения проектов" Height="500" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="СООТНОШЕНИЕ ЗАДАЧ ПО СТАТУСАМ" 
                   FontFamily="{DynamicResource MainFont}" 
                   FontSize="16" FontWeight="Bold" 
                   Foreground="{DynamicResource PrimaryHeaderBrush}"
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- Чистый холст WPF для гарантированной отрисовки секторов диаграммы -->
        <Canvas x:Name="ChartCanvas" Grid.Row="1" Width="300" Height="300" 
                HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Текстовая легенда WPF -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Rectangle Width="12" Height="12" Fill="#0198AF" VerticalAlignment="Center"/>
            <TextBlock Text="К выполнению" Margin="5,0,15,0" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>

            <Rectangle Width="12" Height="12" Fill="#DD4B42" VerticalAlignment="Center"/>
            <TextBlock Text="В работе" Margin="5,0,15,0" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>

            <Rectangle Width="12" Height="12" Fill="#4DC6C5" VerticalAlignment="Center"/>
            <TextBlock Text="Тестирование" Margin="5,0,15,0" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>

            <Rectangle Width="12" Height="12" Fill="#233E76" VerticalAlignment="Center"/>
            <TextBlock Text="Выполнено" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
        </StackPanel>
    </Grid>
</Window>